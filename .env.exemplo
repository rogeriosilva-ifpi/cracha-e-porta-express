# Copie para .env e preencha. Valores reais vêm do cofre da organização,
# nunca deste arquivo. Em produção, o servidor recusa estes exemplos.
NODE_ENV=production
CORS_ORIGINS=https://prontuario.exemplo
# Ed25519, PKCS#8 em uma linha (\n no lugar das quebras)
CHAVE_JWT_ATUAL="troque-por-uma-chave-privada"
# CHAVE_JWT_ANTERIOR=  (durante a rotação: só confere tokens antigos)
# versao:base64 de 32 bytes, para AES-256-GCM
CHAVE_DADOS=v1:troque
# CHAVE_DADOS_ANTERIOR=  (durante a rotação: só decifra)
OIDC_CLIENT_SECRET=troque
